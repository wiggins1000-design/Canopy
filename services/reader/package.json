{
  "name": "canopy-reader",
  "version": "1.0.0",
  "description": "Self-hosted web content extractor for Canopy — handles HTML, JS-rendered pages, PDFs (text + scanned), and images",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "express": "^4.19.2",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^22.12.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
